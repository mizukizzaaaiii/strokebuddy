{
  "expo": {
    "name": "StrokeBuddy",
    "slug": "strokebuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/strokebuddy-cover.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/images/splash-icon.png"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.strokebuddy",
      "usesAppleSignIn": true,

      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "StrokeBuddy uses speech recognition so you can speak instead of typing.",
        "NSMicrophoneUsageDescription": "StrokeBuddy uses the microphone for voice features.",
        "NSCameraUsageDescription": "StrokeBuddy uses the camera to guide and count your exercises and to scan medication labels."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },

      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],

      "package": "com.anonymous.strokebuddy"
    },

    "plugins": [
      "expo-speech-recognition",

      "expo-apple-authentication",

      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.402827347798-r191ntku6qtp9g1jtccn3ir2jaaeurqh"
        }
      ],

      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],

      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "StrokeBuddy uses the camera to guide and count your exercises and to scan medication labels.",
          "enableMicrophonePermission": false
        }
      ],

      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}